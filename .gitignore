# build
/bin/
/dist/
*.test
*.out

# Built commands. `go build ./cmd/openshield-engine/` writes its binary into the working directory,
# which is ordinary and leaves an artifact `git add -A` cannot tell from a source file — that is how
# 161 MB of stale executables reached the public repo once already. scripts/check-no-binaries.sh
# fails the build if one is ever tracked again; this keeps it from happening in the first place.
# Binaries are distributed by `make release`, with a signed manifest and SBOM over them.
/openshield-agent
/openshield-engine
/openshield-fleet-agent
/openshield-gateway
/openshield-provision
/openshield-server
/openshield-worker
/openshieldctl
/openshield-anchor
/openshield-ztna-client
/openshield-print-filter
/openshield-fim-baseline
/openshield-dlp-index

# local dev
.env
*.local.yaml
/tmp/

# case tooling scratch
/evidence/

# go
/vendor/
.claude/worktrees/

# Local agent tooling: generated by `gitnexus analyze` and regenerated on every run, so tracking it
# produces a diff on each reindex. It stays on disk and keeps working; it is not part of the project.
CLAUDE.md
AGENTS.md
.claude/skills/gitnexus/
